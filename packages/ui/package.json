{
    "name": "@Benjamin-Boy/willow-ui",
    "version": "0.0.1",
    "description": "A React component library",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./index.css": "./dist/index.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build --config vite.config.ts",
        "dev": "vite build --watch"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Benjamin-Boy/Willow-UI.git"
    }
}